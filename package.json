{
  "name": "stock-chart",
  "version": "0.1.0",
  "type": "module",
  "description": "WebGL2 主图 + 多副图股票图表 Web Components（P0 可运行骨架）",
  "license": "MIT",
  "author": "lfire",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lfire/stock-trade.git"
  },
  "keywords": ["stock-chart", "web-components", "webgl2", "kline", "candlestick", "a-share"],
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./pure": {
      "types": "./dist/pure.d.ts",
      "default": "./dist/pure.js"
    },
    "./react": {
      "types": "./dist/frameworks/react.d.ts",
      "default": "./dist/frameworks/react.js"
    },
    "./vue": {
      "types": "./dist/frameworks/vue.d.ts",
      "default": "./dist/frameworks/vue.js"
    },
    "./events": {
      "types": "./dist/events.d.ts",
      "default": "./dist/events.js"
    },
    "./core/*.js": "./dist/core/*.js",
    "./core/*": "./dist/core/*.js",
    "./gl/*.js": "./dist/gl/*.js",
    "./gl/*": "./dist/gl/*.js",
    "./compute/*.js": "./dist/compute/*.js",
    "./compute/*": "./dist/compute/*.js",
    "./frameworks/*.js": "./dist/frameworks/*.js",
    "./frameworks/*": "./dist/frameworks/*.js",
    "./elements/*.js": "./dist/elements/*.js",
    "./elements/*": "./dist/elements/*.js"
  },
  "files": ["dist", "README.md", "LICENSE"],
  "sideEffects": false,
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "fetch": "node scripts/fetch-public-data.mjs",
    "predata": "npm run build",
    "data": "node scripts/build-sample-data.mjs && node scripts/build-order-book.mjs",
    "precheck": "npm run build",
    "check": "node scripts/verify.mjs",
    "pretest": "npm run build",
    "test": "node --test scripts/tests/*.test.mjs",
    "typecheck": "node node_modules/typescript/bin/tsc --noEmit -p tsconfig.json",
    "build": "node scripts/build.mjs",
    "prepublishOnly": "npm run check && npm run typecheck && npm test && npm run build",
    "preserve": "npm run build",
    "serve": "node scripts/serve.mjs"
  },
  "devDependencies": {
    "typescript": "5.6.3"
  }
}
