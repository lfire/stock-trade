{
  "name": "stock-chart",
  "version": "0.1.0",
  "type": "module",
  "description": "WebGL2 主图 + 多副图股票图表 Web Components（P0 可运行骨架）",
  "license": "MIT",
  "author": "lfire",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lfire/stock-trade.git"
  },
  "keywords": [
    "stock-chart",
    "web-components",
    "webgl2",
    "kline",
    "candlestick",
    "a-share"
  ],
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./pure": {
      "types": "./dist/pure.d.ts",
      "default": "./dist/pure.js"
    },
    "./react": {
      "types": "./dist/frameworks/react.d.ts",
      "default": "./dist/frameworks/react.js"
    },
    "./vue": {
      "types": "./dist/frameworks/vue.d.ts",
      "default": "./dist/frameworks/vue.js"
    },
    "./events": {
      "types": "./dist/events.d.ts",
      "default": "./dist/events.js"
    },
    "./frameworks/controller": {
      "types": "./dist/frameworks/controller.d.ts",
      "default": "./dist/frameworks/controller.js"
    },
    "./frameworks/svelte": {
      "types": "./dist/frameworks/svelte.d.ts",
      "default": "./dist/frameworks/svelte.js"
    },
    "./frameworks/angular": {
      "types": "./dist/frameworks/angular.d.ts",
      "default": "./dist/frameworks/angular.js"
    },
    "./frameworks/solid": {
      "types": "./dist/frameworks/solid.d.ts",
      "default": "./dist/frameworks/solid.js"
    },
    "./frameworks/vanilla": {
      "types": "./dist/frameworks/vanilla.d.ts",
      "default": "./dist/frameworks/vanilla.js"
    },
    "./core/*.js": {
      "types": "./dist/core/*.d.ts",
      "default": "./dist/core/*.js"
    },
    "./core/*": {
      "types": "./dist/core/*.d.ts",
      "default": "./dist/core/*.js"
    },
    "./gl/*.js": {
      "types": "./dist/gl/*.d.ts",
      "default": "./dist/gl/*.js"
    },
    "./gl/*": {
      "types": "./dist/gl/*.d.ts",
      "default": "./dist/gl/*.js"
    },
    "./compute/*.js": {
      "types": "./dist/compute/*.d.ts",
      "default": "./dist/compute/*.js"
    },
    "./compute/*": {
      "types": "./dist/compute/*.d.ts",
      "default": "./dist/compute/*.js"
    },
    "./elements/*.js": {
      "types": "./dist/elements/*.d.ts",
      "default": "./dist/elements/*.js"
    },
    "./elements/*": {
      "types": "./dist/elements/*.d.ts",
      "default": "./dist/elements/*.js"
    },
    "./workspace/*.js": {
      "types": "./dist/workspace/*.d.ts",
      "default": "./dist/workspace/*.js"
    },
    "./workspace/*": {
      "types": "./dist/workspace/*.d.ts",
      "default": "./dist/workspace/*.js"
    },
    "./modules/*.js": {
      "types": "./dist/modules/*.d.ts",
      "default": "./dist/modules/*.js"
    },
    "./modules/*": {
      "types": "./dist/modules/*.d.ts",
      "default": "./dist/modules/*.js"
    },
    "./frameworks/*.js": {
      "types": "./dist/frameworks/*.d.ts",
      "default": "./dist/frameworks/*.js"
    },
    "./frameworks/*": {
      "types": "./dist/frameworks/*.d.ts",
      "default": "./dist/frameworks/*.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "sideEffects": false,
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "fetch": "node scripts/fetch-public-data.mjs",
    "predata": "npm run build",
    "data": "node scripts/build-sample-data.mjs && node scripts/build-order-book.mjs",
    "precheck": "npm run build",
    "check": "node scripts/verify.mjs",
    "pretest": "npm run build",
    "test": "node --test scripts/tests/*.test.mjs",
    "typecheck": "node node_modules/typescript/bin/tsc --noEmit -p tsconfig.json",
    "build": "node scripts/build.mjs",
    "prepublishOnly": "npm run check && npm run typecheck && npm test && npm run build",
    "preserve": "npm run build",
    "serve": "node scripts/serve.mjs",
    "predocs:io": "npm run build",
    "docs:io": "node scripts/gen-io-doc.mjs"
  },
  "devDependencies": {
    "typescript": "5.6.3"
  }
}
